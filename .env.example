# ==============================================================================
# Axon Panel — Environment Configuration Reference
# ==============================================================================
# All runtime settings can be configured via environment variables or
# persisted in /etc/axon-panel/config.json.

# Node environment mode (production / development)
NODE_ENV=production

# Panel HTTP listener port (default: 9090)
AXONPANEL_PORT=9090

# Primary domain or subdomain for the panel interface
PANEL_DOMAIN=localhost

# Let's Encrypt notification email
LETSENCRYPT_EMAIL=admin@example.com

# Custom directory paths (defaults to system standard locations)
AXONPANEL_CONFIG_DIR=/etc/axon-panel
AXONPANEL_LOG_DIR=/var/log/axon-panel

# FastCGI PHP-FPM default socket
PHP_FPM_SOCKET=/var/run/php/php8.3-fpm.sock

# Upload limit in megabytes
MAX_UPLOAD_MB=512

# Command execution timeout in milliseconds
COMMAND_TIMEOUT_MS=120000
